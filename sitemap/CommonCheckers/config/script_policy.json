{
  "schema_version": 1,
  "policy_name": "common_script_policy",
  "allowed_categories": [
    "mobility",
    "scan",
    "ap",
    "traffic"
  ],
  "allowed_actions_by_category": {
    "mobility": [
      "mobility.report.location",
      "mobility.move",
      "mobility.in2out",
      "mobility.out2in"
    ],
    "scan": [
      "scan.start",
      "scan.stop",
      "scan.once"
    ],
    "ap": [
      "ap.association.get",
      "ap.sta.disassociate",
      "ap.txpower.set",
      "ap.traffic.enable",
      "ap.traffic.disable"
    ],
    "traffic": [
      "traffic.session.start",
      "traffic.session.stop"
    ]
  },
  "blocked_actions_by_category": {
    "mobility": [
      "mobility.turn",
      "mobility.turn_move_turn.forward",
      "mobility.turn_move_turn.backward"
    ]
  },
  "argument_rules_by_category": {
    "mobility": {
      "mobility.report.location": {
        "allowed_keys": [],
        "required_keys": [],
        "numeric_ranges": {}
      },
      "mobility.move": {
        "allowed_keys": [
          "x_m",
          "y_m",
          "heading_deg"
        ],
        "required_keys": [
          "x_m",
          "y_m"
        ],
        "numeric_ranges": {
          "x_m": {
            "min_inclusive": 1.4,
            "max_exclusive": 10.1
          },
          "y_m": {
            "min_inclusive": 0.3,
            "max_exclusive": 11.1
          },
          "heading_deg": {
            "min_inclusive": 0.0,
            "max_exclusive": 360.0
          }
        }
      },
      "mobility.in2out": {
        "allowed_keys": [],
        "required_keys": [],
        "numeric_ranges": {}
      },
      "mobility.out2in": {
        "allowed_keys": [],
        "required_keys": [],
        "numeric_ranges": {}
      }
    },
    "scan": {
      "scan.start": {
        "allowed_keys": [],
        "required_keys": [],
        "numeric_ranges": {}
      },
      "scan.stop": {
        "allowed_keys": [],
        "required_keys": [],
        "numeric_ranges": {}
      },
      "scan.once": {
        "allowed_keys": [],
        "required_keys": [],
        "numeric_ranges": {}
      }
    },
    "ap": {
      "ap.association.get": {
        "allowed_keys": [],
        "required_keys": [],
        "numeric_ranges": {}
      },
      "ap.sta.disassociate": {
        "allowed_keys": [
          "sta_mac",
          "time_period"
        ],
        "required_keys": [
          "sta_mac",
          "time_period"
        ],
        "numeric_ranges": {},
        "integer_ranges": {
          "time_period": {
            "min_exclusive": 0,
            "max_exclusive": 300
          }
        },
        "string_formats": {
          "sta_mac": "mac_address"
        }
      },
      "ap.txpower.set": {
        "allowed_keys": [
          "txpower",
          "sta_mac"
        ],
        "required_keys": [
          "txpower"
        ],
        "numeric_ranges": {},
        "integer_ranges": {
          "txpower": {
            "min_inclusive": 0,
            "max_inclusive": 30
          }
        },
        "string_formats": {
          "sta_mac": "mac_address"
        }
      },
      "ap.traffic.enable": {
        "allowed_keys": [],
        "required_keys": [],
        "numeric_ranges": {}
      },
      "ap.traffic.disable": {
        "allowed_keys": [],
        "required_keys": [],
        "numeric_ranges": {}
      }
    },
    "traffic": {
      "traffic.session.start": {
        "allowed_keys": [
          "session_id",
          "ac",
          "protocol",
          "duration_sec",
          "report_interval_sec",
          "reverse",
          "bitrate",
          "packet_size",
          "parallel"
        ],
        "required_keys": [
          "session_id",
          "ac",
          "protocol",
          "duration_sec",
          "report_interval_sec",
          "reverse"
        ],
        "numeric_ranges": {},
        "integer_ranges": {
          "duration_sec": {
            "min_exclusive": 60,
            "max_inclusive": 1200
          },
          "report_interval_sec": {
            "min_inclusive": 60,
            "max_inclusive": 60
          },
          "packet_size": {
            "min_inclusive": 64,
            "max_inclusive": 1472
          },
          "parallel": {
            "min_inclusive": 1,
            "max_inclusive": 16
          }
        },
        "string_formats": {
          "session_id": "traffic_session_id"
        },
        "string_enums": {
          "ac": [
            "vo",
            "vi",
            "be",
            "bk"
          ],
          "protocol": [
            "tcp",
            "udp"
          ],
          "bitrate": [
            "100K",
            "500K",
            "1M",
            "5M",
            "10M",
            "20M",
            "50M",
            "100M"
          ]
        },
        "boolean_fields": [
          "reverse"
        ],
        "conditional_required_keys": {
          "protocol": {
            "tcp": [
              "parallel"
            ],
            "udp": [
              "bitrate",
              "packet_size"
            ]
          }
        },
        "conditional_forbidden_keys": {
          "protocol": {
            "tcp": [
              "bitrate",
              "packet_size"
            ],
            "udp": [
              "parallel"
            ]
          }
        }
      },
      "traffic.session.stop": {
        "allowed_keys": [
          "session_id"
        ],
        "required_keys": [
          "session_id"
        ],
        "numeric_ranges": {},
        "string_formats": {
          "session_id": "traffic_session_id"
        }
      }
    }
  },
  "allowed_scan_actions": [
    "scan.start",
    "scan.stop",
    "scan.once"
  ],
  "nonmoving_scan_actions": [
    "scan.start",
    "scan.stop",
    "scan.once"
  ],
  "allowed_mobility_actions": [
    "mobility.report.location",
    "mobility.move",
    "mobility.in2out",
    "mobility.out2in"
  ],
  "blocked_mobility_actions": [
    "mobility.turn",
    "mobility.turn_move_turn.forward",
    "mobility.turn_move_turn.backward"
  ],
  "moving_mobility_actions": [
    "mobility.move",
    "mobility.in2out",
    "mobility.out2in"
  ],
  "nonmoving_mobility_actions": [
    "mobility.report.location"
  ],
  "first_mobility_action_required": "mobility.report.location",
  "min_seconds_after_report_location_before_first_move": 60,
  "global_min_seconds_between_moving_mobility_commands": 180,
  "max_single_mobility_move_distance_m": 3.0
}
